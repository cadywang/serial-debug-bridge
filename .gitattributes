# Normalise line endings: shell/python must be LF, Windows scripts keep CRLF-safe LF too.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.service text eol=lf

# Binary
*.bin  binary
*.png  binary
*.gz   binary
*.tgz  binary

# Extension-less scripts must stay LF: a CRLF shebang/`set -euo pipefail`
# breaks them when they are executed directly.
/skill/serial-debug-bridge/scripts/sdb  text eol=lf
/tools/git-hooks/commit-msg             text eol=lf
