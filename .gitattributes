# Normalise line endings: shell/python must be LF, Windows scripts keep CRLF-safe LF too.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.service text eol=lf

# Binary
*.bin  binary
*.png  binary
*.gz   binary
*.tgz  binary