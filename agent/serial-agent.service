# Serial debug bridge agent (Linux client).
#   sudo cp serial-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now serial-agent
[Unit]
Description=Serial debug bridge agent (UART <-> TCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Adjust the path, device and baud to match your setup.
ExecStart=/usr/bin/python3 /opt/serial-debug-bridge/serial_agent.py --port /dev/ttyUSB0 --baud 115200 --tcp-port 7801
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
